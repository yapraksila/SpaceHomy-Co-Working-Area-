@model ourwebpage.Models.ProfileIndexViewModel
@using System.Globalization
@using System.Linq

@{
    ViewBag.Title = "My Profile";
    var enCulture = CultureInfo.GetCultureInfo("en-US");

    var userName = !string.IsNullOrEmpty(Model.UserName)
        ? Model.UserName
        : User.Identity.Name;

    var activeBookings = Model.ActiveBookings != null
        ? Model.ActiveBookings.ToList()
        : new System.Collections.Generic.List<ourwebpage.Models.Booking>();

    var pastBookings = Model.PastBookings != null
        ? Model.PastBookings.ToList()
        : new System.Collections.Generic.List<ourwebpage.Models.Booking>();
}

<style>
    .profile-page-wrapper {
        background-color: #FAF7F0;
        min-height: calc(100vh - 80px);
        padding: 44px 0 72px;
        color: #3B2F23;
        font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    }

    .profile-container {
        max-width: 1060px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .profile-top-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        margin-bottom: 44px;
    }

    .profile-title {
        font-size: 2.35rem;
        font-weight: 700;
        color: #3B2F23;
        margin: 10px 0 0 0;
        letter-spacing: -0.5px;
    }

    .account-card {
        background-color: #65743A;
        color: #FFFFFF;
        border-radius: 10px;
        padding: 18px 22px;
        width: 245px;
        flex-shrink: 0;
        margin-left: auto;
        box-shadow: 0 4px 12px rgba(59, 47, 35, 0.08);
    }

    .account-card-label {
        font-size: 0.65rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0.85;
        margin-bottom: 14px;
    }

    .account-card-username {
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .account-card-fullname {
        font-size: 0.84rem;
        opacity: 0.92;
        margin-bottom: 10px;
    }

    .account-card-email {
        font-size: 0.76rem;
        opacity: 0.85;
        word-break: break-all;
        margin-bottom: 16px;
    }

    .btn-edit-profile {
        display: block;
        width: 100%;
        text-align: center;
        background-color: #6B4A35;
        color: #FFFFFF;
        border: none;
        border-radius: 5px;
        padding: 8px 16px;
        font-size: 0.8rem;
        font-weight: 500;
        line-height: 1.2;
        cursor: pointer;
    }

        .btn-edit-profile:hover,
        .btn-edit-profile:focus {
            background-color: #543827;
            color: #FFFFFF;
        }

    .section-block {
        margin-bottom: 42px;
    }

    .section-heading {
        font-size: 1.25rem;
        font-weight: 700;
        color: #3B2F23;
        margin-bottom: 16px;
    }

    .reservation-card {
        background-color: #F3E39A;
        border-radius: 8px;
        padding: 18px 24px;
        margin-bottom: 16px;
        color: #3B2F23;
    }

    .reservation-grid {
        display: grid;
        grid-template-columns: 1.3fr 1.2fr 1.5fr;
        gap: 20px;
        align-items: start;
    }

    .res-field-label {
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6E5D46;
        margin-bottom: 4px;
    }

    .res-room-value {
        font-size: 1.05rem;
        font-weight: 700;
        color: #3B2F23;
    }

    .res-meta-value {
        font-size: 0.92rem;
        font-weight: 600;
        color: #3B2F23;
    }

    .res-status-text {
        font-size: 0.75rem;
        color: #6E5D46;
        margin-top: 22px;
        display: inline-block;
    }

    .res-right-col {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 76px;
    }

    .res-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
        flex-wrap: wrap;
    }

        .res-actions form {
            margin: 0;
            display: inline-flex;
        }

    .btn-brown {
        background-color: #6B4A35;
        color: #FFFFFF;
        border: none;
        border-radius: 5px;
        padding: 7px 18px;
        font-size: 0.8rem;
        font-weight: 500;
        line-height: 1.2;
        white-space: nowrap;
        cursor: pointer;
    }

        .btn-brown:hover:not(:disabled) {
            background-color: #543827;
            color: #FFFFFF;
        }

        .btn-brown:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .btn-outline-brown {
        background-color: transparent;
        color: #6B4A35;
        border: 1px solid #6B4A35;
        border-radius: 5px;
        padding: 7px 18px;
        font-size: 0.8rem;
        font-weight: 500;
        line-height: 1.2;
        white-space: nowrap;
        cursor: pointer;
    }

        .btn-outline-brown:hover {
            background-color: rgba(107, 74, 53, 0.08);
        }

    .empty-reservation-box {
        background-color: #F3E39A;
        border-radius: 8px;
        padding: 22px 24px;
        color: #6E5D46;
        font-size: 0.92rem;
    }

    .custom-modal-backdrop {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(59, 47, 35, 0.55);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

        .custom-modal-backdrop.show {
            display: flex;
        }

    .custom-modal-box {
        background-color: #FAF7F0;
        color: #3B2F23;
        border-radius: 10px;
        width: 100%;
        max-width: 460px;
        padding: 24px 28px;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
        animation: modalFadeIn 0.18s ease-out;
    }

    @@keyframes modalFadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .custom-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(59, 47, 35, 0.12);
        padding-bottom: 12px;
        margin-bottom: 18px;
    }

    .custom-modal-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0;
    }

    .custom-modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        line-height: 1;
        color: #6E5D46;
        cursor: pointer;
    }

    .custom-modal-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed rgba(59, 47, 35, 0.1);
        font-size: 0.92rem;
    }

        .custom-modal-row:last-child {
            border-bottom: none;
        }

    .custom-modal-label {
        color: #6E5D46;
        font-weight: 600;
    }

    .custom-modal-value {
        font-weight: 700;
        color: #3B2F23;
    }

    .edit-form-group {
        margin-bottom: 14px;
    }

    .edit-form-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #6E5D46;
        margin-bottom: 6px;
    }

    .edit-form-input {
        width: 100%;
        padding: 9px 12px;
        border: 1px solid rgba(59, 47, 35, 0.25);
        border-radius: 6px;
        background-color: #FFFFFF;
        color: #3B2F23;
        font-size: 0.92rem;
        box-sizing: border-box;
    }

        .edit-form-input:focus {
            outline: none;
            border-color: #65743A;
            box-shadow: 0 0 0 2px rgba(101, 116, 58, 0.18);
        }

        .edit-form-input:disabled {
            background-color: #EFECE4;
            color: #6E5D46;
            cursor: not-allowed;
        }

    .custom-modal-footer {
        margin-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    @@media (max-width: 768px) {
        .profile-top-row {
            flex-direction: column;
        }

        .account-card {
            margin-left: 0;
            width: 100%;
            max-width: 100%;
        }

        .reservation-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .res-status-text {
            margin-top: 8px;
        }

        .res-right-col {
            min-height: auto;
        }

        .res-actions {
            justify-content: flex-start;
        }
    }
</style>

<div class="profile-page-wrapper">
    <div class="profile-container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="profile-top-row">
            <div>
                <h1 class="profile-title">My Profile</h1>
            </div>

            <div class="account-card">
                <div class="account-card-label">ACCOUNT</div>
                <div class="account-card-username">@userName</div>
                <div class="account-card-fullname">@Model.UserProfile.Name</div>
                <div class="account-card-email">@Model.UserProfile.Email</div>
                <button type="button" class="btn-edit-profile" onclick="openEditProfileModal()">Edit Profile</button>
            </div>
        </div>

        <div class="section-block">
            <h2 class="section-heading">Active reservations</h2>

            @if (!activeBookings.Any())
            {
                <div class="empty-reservation-box">
                    You have no active reservations.
                </div>
            }
            else
            {
                foreach (var booking in activeBookings)
                {
                    string roomName = booking.Facility != null ? booking.Facility.Name : ("Room #" + booking.FacilityId);
                    string formattedDate = booking.BookingDay.ToString("dd MMMM yyyy", enCulture);
                    string formattedTime = booking.StartTime.ToString(@"hh\:mm") + " – " + booking.EndTime.ToString(@"hh\:mm");
                    string statusLabel = (booking.Status == "Confirmed" || booking.Status == "Pending") ? "Upcoming" : booking.Status;

                    bool hasCheckedIn = booking.CheckInAt.HasValue || booking.Status == "CheckedIn";
                    bool hasCheckedOut = booking.CheckOutAt.HasValue || booking.Status == "Completed";
                    System.DateTime scheduledStart = booking.BookingDay.Date + booking.StartTime;
                    System.DateTime earliestCheckIn = scheduledStart.AddMinutes(-5);
                    bool canCheckInNow = System.DateTime.Now >= earliestCheckIn;

                    <div class="reservation-card">
                        <div class="reservation-grid">
                            <div>
                                <div class="res-field-label">ROOM</div>
                                <div class="res-room-value">@roomName</div>
                                <span class="res-status-text">@statusLabel</span>
                            </div>

                            <div>
                                <div class="res-field-label">DATE</div>
                                <div class="res-meta-value">@formattedDate</div>
                            </div>

                            <div class="res-right-col">
                                <div>
                                    <div class="res-field-label">TIME</div>
                                    <div class="res-meta-value">@formattedTime</div>
                                </div>

                                <div class="res-actions">
                                    @if (!hasCheckedIn && !hasCheckedOut)
                                    {
                                        if (canCheckInNow)
                                        {
                                            using (Html.BeginForm("CheckIn", "Profile", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("id", booking.BookingId)
                                                <button type="submit" class="btn btn-brown">Check-in</button>
                                            }
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-brown"
                                                    disabled
                                                    title="Available from @earliestCheckIn.ToString("HH:mm", enCulture)">
                                                Check-in (@earliestCheckIn.ToString("HH:mm", enCulture))
                                            </button>
                                        }

                                        using (Html.BeginForm("CancelBooking", "Profile", FormMethod.Post, new { onsubmit = "return confirm('Are you sure you want to cancel this reservation?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", booking.BookingId)
                                            <button type="submit" class="btn btn-brown">Cancel</button>
                                        }
                                    }
                                    else if (hasCheckedIn && !hasCheckedOut)
                                    {
                                        using (Html.BeginForm("CheckOut", "Profile", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", booking.BookingId)
                                            <button type="submit" class="btn btn-brown">Check-out</button>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="section-block">
            <h2 class="section-heading">Old reservations</h2>

            @if (!pastBookings.Any())
            {
                <div class="empty-reservation-box">
                    You have no past reservations.
                </div>
            }
            else
            {
                foreach (var booking in pastBookings)
                {
                    string roomName = booking.Facility != null ? booking.Facility.Name : ("Room #" + booking.FacilityId);
                    string formattedDate = booking.BookingDay.ToString("dd MMMM yyyy", enCulture);
                    string formattedTime = booking.StartTime.ToString(@"hh\:mm") + " – " + booking.EndTime.ToString(@"hh\:mm");
                    string checkInDisplay = booking.CheckInAt.HasValue
                        ? booking.CheckInAt.Value.ToString("dd MMM yyyy HH:mm", enCulture)
                        : "Not recorded";
                    string checkOutDisplay = booking.CheckOutAt.HasValue
                        ? booking.CheckOutAt.Value.ToString("dd MMM yyyy HH:mm", enCulture)
                        : "Not recorded";
                    string statusLabel = booking.Status == "Cancelled" ? "Cancelled" : "Completed";

                    <div class="reservation-card">
                        <div class="reservation-grid">
                            <div>
                                <div class="res-field-label">ROOM</div>
                                <div class="res-room-value">@roomName</div>
                                <span class="res-status-text">@statusLabel</span>
                            </div>

                            <div>
                                <div class="res-field-label">DATE</div>
                                <div class="res-meta-value">@formattedDate</div>
                            </div>

                            <div class="res-right-col">
                                <div>
                                    <div class="res-field-label">TIME</div>
                                    <div class="res-meta-value">@formattedTime</div>
                                </div>

                                <div class="res-actions">
                                    <button type="button"
                                            class="btn btn-brown"
                                            onclick="openBookingModal(this)"
                                            data-id="@booking.BookingId"
                                            data-room="@roomName"
                                            data-date="@formattedDate"
                                            data-checkin="@checkInDisplay"
                                            data-checkout="@checkOutDisplay"
                                            data-status="@statusLabel">
                                        Details
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</div>

<!-- Edit Profile Modal -->
<div id="editProfileModal" class="custom-modal-backdrop" onclick="closeModalOnBackdrop(event, 'editProfileModal')">
    <div class="custom-modal-box">
        <div class="custom-modal-header">
            <h5 class="custom-modal-title">Edit Profile</h5>
            <button type="button" class="custom-modal-close" onclick="closeEditProfileModal()">×</button>
        </div>

        @using (Html.BeginForm("Edit", "Profile", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("RoleId", Model.UserProfile.RoleId)
            @Html.Hidden("UserName", userName)
            @Html.Hidden("RoleName", Model.UserProfile.RoleName)

            <div class="edit-form-group">
                <label class="edit-form-label" for="editUserName">Username</label>
                <input type="text" id="editUserName" class="edit-form-input" value="@userName" disabled />
            </div>

            <div class="edit-form-group">
                <label class="edit-form-label" for="editFullName">Full Name</label>
                <input type="text" id="editFullName" name="Name" class="edit-form-input" value="@Model.UserProfile.Name" required />
            </div>

            <div class="edit-form-group">
                <label class="edit-form-label" for="editEmail">Email</label>
                <input type="email" id="editEmail" name="Email" class="edit-form-input" value="@Model.UserProfile.Email" required />
            </div>

            <div class="custom-modal-footer">
                <button type="button" class="btn-outline-brown" onclick="closeEditProfileModal()">Cancel</button>
                <button type="submit" class="btn btn-brown">Save Changes</button>
            </div>
        }
    </div>
</div>

<!-- Reservation Details Modal -->
<div id="bookingDetailModal" class="custom-modal-backdrop" onclick="closeModalOnBackdrop(event, 'bookingDetailModal')">
    <div class="custom-modal-box">
        <div class="custom-modal-header">
            <h5 class="custom-modal-title">Reservation Details</h5>
            <button type="button" class="custom-modal-close" onclick="closeBookingModal()">×</button>
        </div>

        <div>
            <div class="custom-modal-row">
                <span class="custom-modal-label">Reservation ID</span>
                <span class="custom-modal-value" id="modalResId"></span>
            </div>
            <div class="custom-modal-row">
                <span class="custom-modal-label">Room</span>
                <span class="custom-modal-value" id="modalResRoom"></span>
            </div>
            <div class="custom-modal-row">
                <span class="custom-modal-label">Date</span>
                <span class="custom-modal-value" id="modalResDate"></span>
            </div>
            <div class="custom-modal-row">
                <span class="custom-modal-label">Check-in</span>
                <span class="custom-modal-value" id="modalResCheckIn"></span>
            </div>
            <div class="custom-modal-row">
                <span class="custom-modal-label">Check-out</span>
                <span class="custom-modal-value" id="modalResCheckOut"></span>
            </div>
            <div class="custom-modal-row">
                <span class="custom-modal-label">Status</span>
                <span class="custom-modal-value" id="modalResStatus"></span>
            </div>
        </div>

        <div class="custom-modal-footer">
            <button type="button" class="btn btn-brown" onclick="closeBookingModal()">Close</button>
        </div>
    </div>
</div>

<script>
    function openEditProfileModal() {
        document.getElementById('editProfileModal').classList.add('show');
    }

    function closeEditProfileModal() {
        document.getElementById('editProfileModal').classList.remove('show');
    }

    function openBookingModal(button) {
        document.getElementById('modalResId').textContent = '#' + button.getAttribute('data-id');
        document.getElementById('modalResRoom').textContent = button.getAttribute('data-room');
        document.getElementById('modalResDate').textContent = button.getAttribute('data-date');
        document.getElementById('modalResCheckIn').textContent = button.getAttribute('data-checkin');
        document.getElementById('modalResCheckOut').textContent = button.getAttribute('data-checkout');
        document.getElementById('modalResStatus').textContent = button.getAttribute('data-status');

        document.getElementById('bookingDetailModal').classList.add('show');
    }

    function closeBookingModal() {
        document.getElementById('bookingDetailModal').classList.remove('show');
    }

    function closeModalOnBackdrop(event, modalId) {
        if (event.target.id === modalId) {
            document.getElementById(modalId).classList.remove('show');
        }
    }

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeBookingModal();
            closeEditProfileModal();
        }
    });
</script>