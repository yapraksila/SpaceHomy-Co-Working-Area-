<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SpaceHomy Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f4f6f9;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }

        #wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        #sidebar-wrapper {
            min-width: 250px;
            max-width: 250px;
            background-color: #1e293b;
            color: #fff;
            transition: margin 0.25s ease-out;
        }

            #sidebar-wrapper .sidebar-heading {
                padding: 1.25rem 1.5rem;
                font-size: 1.3rem;
                font-weight: 700;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                letter-spacing: 0.5px;
            }

            #sidebar-wrapper .list-group-item {
                background-color: transparent;
                color: #cbd5e1;
                border: none;
                padding: 0.85rem 1.5rem;
                font-size: 0.95rem;
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

                #sidebar-wrapper .list-group-item:hover,
                #sidebar-wrapper .list-group-item.active {
                    background-color: #334155;
                    color: #ffffff;
                    border-left: 4px solid #3b82f6;
                }

        #page-content-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        #wrapper.toggled #sidebar-wrapper {
            margin-left: -250px;
        }

        @@media (max-width: 768px) {
            #sidebar-wrapper {
                margin-left: -250px;
            }

            #wrapper.toggled #sidebar-wrapper {
                margin-left: 0;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div id="wrapper">
        <!-- Sol Yan Menü (Sidebar) -->
        <div id="sidebar-wrapper">
            <div class="sidebar-heading">
                <i class="bi bi-building"></i> SpaceHomy Admin
            </div>
            <div class="list-group list-group-flush my-2">
                <a href="@Url.Action("Index", "Admin")" class="list-group-item active">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a href="@Url.Action("MainPage", "Home")" class="list-group-item">
                    <i class="bi bi-house-door"></i> Back to Site
                </a>
                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "adminLogoutForm" }))
                {
                @Html.AntiForgeryToken()
                <a href="javascript:document.getElementById('adminLogoutForm').submit()" class="list-group-item text-danger mt-3">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
                }
            </div>
        </div>

        <!-- Sağ Ana İçerik Alanı -->
        <div id="page-content-wrapper">
            <!-- Üst Bilgi Çubuğu (Navbar) -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4 py-3">
                <button class="btn btn-outline-secondary btn-sm" id="menu-toggle" type="button">
                    <i class="bi bi-list"></i>
                </button>
                <span class="navbar-text ms-auto fw-semibold">
                    <i class="bi bi-person-circle"></i> @User.Identity.Name
                </span>
            </nav>

            <!-- Dinamik Sayfa İçeriği -->
            <main class="container-fluid p-4">
                @RenderBody()
            </main>
        </div>
    </div>

