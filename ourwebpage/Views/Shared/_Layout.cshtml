<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <!-- Ortak/Genel CSS dosyaları -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <script src="~/Scripts/modernizr-2.6.2.js"></script>
</head>
<body>
    <!-- Shared HEADER  -->
    <header class="top_banner_space">
        <a class="brand" href="@Url.Action("MainPage", "Home")">
            <img src="@Url.Content("~/Content/logo.png")" alt="Logo">
            <h1><b>SpaceHomy</b></h1>
        </a>

        <nav>
            <a href="#">Products</a>
            <a href="#">Solutions</a>
            <a href="#">Community</a>
            <a href="#">Resources</a>
            <a href="#">Pricing</a>
            <a href="@Url.Action("ContactPage", "Home")">Contact</a>
        </nav>

        <div id="topLayer">
            <button id="sign_in_button" onclick="window.location.href='#'">Sign In</button>
            <button id="log_in_button" onclick="window.location.href='#'">Log In</button>
        </div>
    </header>

    <!-- Kapsayıcı sınıfları kaldırdık, sayfalar kendi stilleriyle tam oturacak -->
    @RenderBody()

    <!-- Shared Footer  -->
    <footer class="bottom_info_place">
        <a class="bottom_info_column" href="@Url.Action("ContactPage", "Home")">
            <h3>Contact</h3>
            <p>Get in touch with us.</p>
        </a>
        <a class="bottom_info_column" href="@Url.Action("AboutPage", "Home")">
            <h3>About Us</h3>
            <p>Learn more about us.</p>
        </a>
        <a class="bottom_info_column" href="#">
            <h3>Help</h3>
            <p>Check out the frequently asked questions.</p>
        </a>
    </footer>

    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>

    <style>
        header {
            display: flex; /*put elements of header next to each other*/
            justify-content: space-between; /*align left and right*/
            align-items: center; /*align elements of header in the center */
            background-color: white; /*COLOR*/
            padding: 20px 32px; /*space for the items from header lines*/
            color: black /*text color*/
        }

        .brand {
            display: flex; /*logo and brand name next to each other*/
            align-items: center;
            gap: 12px;
        }

        header img {
            width: 35px;
            height: 40px;
        }

        header h1 {
            font-size: 28px;
        }

        nav {
            display: flex;
            gap: 28px;
            margin-left: auto; /* push the menu to the right */
            margin-right: 32px;
        }

            nav a {
                text-decoration: none;
                color: #222;
                font-size: 15px;
            }

        #topLayer {
            display: flex;
            gap: 12px;
        }

        button {
            background-color: #3498db; /* button color */
            color: white; /* text color */
            border: none; /* no frame */
            padding: 8px 16px; /* empty space in button*/
            border-radius: 5px; /* to make circular corners */
            font-weight: bold;
        }

        #sign_in_button {
            background-color: #EDEDED; /* light button with frame */
            color: #222;
            border: 1px solid #999;
            font-weight: normal;
        }

        #log_in_button {
            background-color: #2B2B2B; /* dark button */

        }

        footer {
            background-color: white; /* bacground color */
            width: 100%;
            margin: 0 auto;
            display: flex;
            text-align: left;
            gap: 27px;
            padding: 30px 57px 30px 57px; /*top,right,bottom,left*/
        }

        .bottom_info_column {
            flex: 1; /* three equal columns */
        }

            .bottom_info_column:first-child {
                border-right: 1px solid #D9C3B3; /* thin line after the first column */
            }

            .bottom_info_column h3 {
                font-size: 20px;
                color: #1F2F46;
                margin-bottom: 10px;
            }

            .bottom_info_column p {
                color: #6B7C93;
                font-size: 15px;
            }

        footer a {
            text-decoration: none; /* Removes the underline from links */
            color: #333; /* text color */
            font-weight: 500;
        }
    </style>
</body>
</html>