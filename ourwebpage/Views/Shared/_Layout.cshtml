<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <!-- Ortak/Genel CSS dosyaları -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <script src="~/Scripts/modernizr-2.6.2.js"></script>
</head>
<body>
    <!-- Shared HEADER  -->
    <header class="top_banner_space">
        <a class="brand" href="@Url.Action("MainPage", "Home")">
            <img src="@Url.Content("~/Content/logo.png")" alt="Logo">
            <h1><b>SpaceHomy</b></h1>
        </a>

        <nav>
            <a href="#">Products</a>
            <a href="#">Solutions</a>
            <a href="#">Community</a>
            <a href="#">Resources</a>
            <a href="#">Pricing</a>
            <a href="@Url.Action("ContactPage", "Home")">Contact</a>
        </nav>

        <div id="topLayer">
            <button id="sign_in_button" onclick="window.location.href='#'">Sign In</button>
            <button id="log_in_button" onclick="window.location.href='#'">Log In</button>
        </div>
    </header>

    <!-- Kapsayıcı sınıfları kaldırdık, sayfalar kendi stilleriyle tam oturacak -->
    @RenderBody()

    <!-- Shared Footer  -->
    <footer class="bottom_info_place">
        <a class="bottom_info_column" href="@Url.Action("ContactPage", "Home")">
            <h3>Contact</h3>
            <p>Get in touch with us.</p>
        </a>
        <a class="bottom_info_column" href="@Url.Action("AboutPage", "Home")">
            <h3>About Us</h3>
            <p>Learn more about us.</p>
        </a>
        <a class="bottom_info_column" href="#">
            <h3>Help</h3>
            <p>Check out the frequently asked questions.</p>
        </a>
    </footer>

    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
</body>
</html>