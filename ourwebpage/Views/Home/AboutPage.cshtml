
@{
    ViewBag.Title = "About Us - SpaceHomy";
}


<style>
    body {
        background-color: #ffffff;
        color: #5B6648;
        line-height: 1.6;
        position: relative;
    }

        /* background image*/
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1600&q=80');
            background-size: cover;
            background-position: center;
            opacity: 0.04;
            z-index: -1;
        }

    .brand {
        text-decoration: none;
        color: inherit;
    }

    .container {
        width: 85%;
        max-width: 1100px;
        margin: 0 auto;
    }

    .about_main {
        padding: 40px 0;
    }

    .mission {
        max-width: 800px;
        margin-bottom: 40px;
    }

        .mission h1 {
            font-size: 36px;
            margin-bottom: 15px;
            color: #5B6648;
        }

        .mission p {
            font-size: 15px;
            color: #555;
        }

    .banner {
        width: 100%;
        height: 380px;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 50px;
        border: 1px solid #ddd;
    }

        .banner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .vision h2 {
        font-size: 26px;
        margin-bottom: 25px;
        color: #5B6648;
    }

    .cards-grid {
        display: flex;
        gap: 20px;
        margin-bottom: 60px;
    }

    .card {
        flex: 1;
        background: #fdfbf7;
        border: 1px solid #e5dec9;
        padding: 24px;
        border-radius: 8px;
    }

        .card h3 {
            font-size: 18px;
            margin-bottom: 10px;
            color: #5B6648;
        }

        .card p {
            font-size: 13px;
            color: #666;
        }
</style>


<div class="container">
    <div class="about_main">
        <section class="mission">
            <h1>Our Mission: Crafting the Future of Work.</h1>
            <p>
                More than just desks and offices, SpaceHomy provides meticulously curated environments that adapt to your team's dynamic needs.
                We fuse hospitality, technology, and design to fuel productivity.
            </p>
        </section>

        <div class="banner">
            <img src="@Url.Content("~/Content/p_aboutus.jpeg")" alt="About Us Banner">
        </div>

        <section class="vision">
            <h2>Our Vision</h2>
            <div class="cards-grid">
                <div class="card">
                    <h3>Who Are We?</h3>
                    <ul>
                        <li>
                            "We don't just offer a space; we deliver an inspiring experience."
                            At SpaceHomy, we are transforming the traditional office concept by offering comfortable, flexible,
                            and customizable spatial solutions tailored to your needs—from individual work to community gatherings.
                        </li>
                    </ul>
                </div>
                <div class="card">
                    <h3>Who Is SpaceHomy For?</h3>
                    <ul class="spacehomy-audience-list">
                        <li><strong>Entrepreneurs & Investors:</strong> Those seeking a prestigious and fully-equipped space.</li>
                        <li><strong>Creative Teams & Agencies:</strong> Dynamic groups developing innovative projects.</li>
                        <li><strong>Freelancers:</strong> Those who want a professional working environment with the comfort of home.</li>
                        <li><strong>Event Organizers:</strong> Anyone looking for an inviting venue for workshops and product launches.</li>
                    </ul>
                </div>
                <div class="card">
                    <h3>How Do I Book?</h3>
                    <div class="booking-process">
                        <ol class="process-steps">
                            <li>Choose the room type that best fits your needs,</li>
                            <li>Select your preferred date and time slot,</li>
                            <li>Quickly complete your reservation. Customize your space for your event whenever you wish!</li>
                        </ol>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

